{
  "name": "@merkaba-god-complex/context-manager",
  "version": "1.0.0",
  "description": "Dimensional context manager for all 5 contexts with containerized agent support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "context",
    "dimensional",
    "containerized",
    "agents",
    "kubernetes",
    "docker",
    "merkaba"
  ],
  "author": "Brian Thorne",
  "license": "MIT",
  "dependencies": {
    "@merkaba-god-complex/identity-kernel": "file:../identity-kernel",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "express": "^4.18.2",
    "lodash": "^4.17.21",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.44",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.4",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  }
}
