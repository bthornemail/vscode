{
  "name": "@merkaba-god-complex/mcp-agent-communication",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) implementation for LLM agent-to-agent communication with geometric message routing and autonomous coordination",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server": "dist/mcp-server.js",
    "mcp-client": "dist/mcp-client.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "postbuild": "chmod +x dist/mcp-server.js dist/mcp-client.js",
    "example:basic": "tsx examples/basic-usage.ts",
    "example:consensus": "tsx examples/geometric-consensus.ts",
    "example:coordination": "tsx examples/autonomous-coordination.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "agent",
    "communication",
    "geometric",
    "consensus",
    "autonomous",
    "websocket",
    "mqtt",
    "webrtc",
    "merkaba"
  ],
  "author": "Brian Thorne",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.16.0",
    "mqtt": "^5.3.3",
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "simple-peer": "^9.11.1",
    "cors": "^2.8.5",
    "uuid": "^9.0.1",
    "rxjs": "^7.8.1",
    "lodash": "^4.17.21",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "@types/mqtt": "^2.5.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.5",
    "@types/simple-peer": "^9.11.8",
    "@types/node": "^20.10.4",
    "@types/uuid": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "tsx": "^4.6.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "prettier": "^3.1.1"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "examples/**/*",
    "README.md",
    "QUICKSTART.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/merkaba-god-complex/mcp-agent-communication.git"
  },
  "bugs": {
    "url": "https://github.com/merkaba-god-complex/mcp-agent-communication/issues"
  },
  "homepage": "https://github.com/merkaba-god-complex/mcp-agent-communication#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}